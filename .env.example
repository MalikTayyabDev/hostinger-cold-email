# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# ssl (port 465) or starttls (port 587)
SMTP_ENCRYPTION=ssl
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=CHANGE_ME

# Sender
FROM_NAME=Your Name
FROM_EMAIL=your-email@yourdomain.com

# Hostinger IMAP for reply detection
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=your-email@yourdomain.com
IMAP_PASSWORD=CHANGE_ME
IMAP_FOLDER=INBOX

# App
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE=campaign.db
# Optional — set a fixed secret for persistent sessions across restarts
SECRET_KEY=

# Sending controls
DRY_RUN=true
DAILY_SEND_LIMIT=20
SEND_DELAY_MIN_SECONDS=45
SEND_DELAY_MAX_SECONDS=120

# Follow-up timing
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7

# Optional public HTTPS base URL for unsubscribe links
# Example: https://outreach.yourdomain.com
PUBLIC_BASE_URL=

# Campaign
CAMPAIGN_NAME=Website Outreach
REPLY_TO=your-email@yourdomain.com

# Optional dashboard authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Test email for preview/test-send feature
TEST_EMAIL=

# Email footer text
EMAIL_FOOTER=If you'd rather not receive messages from me, you can reply "unsubscribe".

# Follow-ups
MAX_FOLLOWUPS=3

# --- Production (Supabase + Vercel) ---
# Leave DATABASE_URL empty for local SQLite development
DATABASE_URL=

# Supabase project URL + service key (optional, for future use)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Secret for Vercel Cron endpoints (/api/cron/send, /api/cron/inbox)
CRON_SECRET=

# Set after Vercel deploy — required for unsubscribe links
# PUBLIC_BASE_URL=https://your-app.vercel.app
